{
  "name": "@1claw/browser-bridge-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "typecheck:tests": "pnpm -r --if-present typecheck:tests",
    "verify": "pnpm typecheck && pnpm typecheck:tests && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright-core": "^1.62.1",
    "puppeteer-core": "^25.9.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.26.0"
}
